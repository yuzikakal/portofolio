---
import Layout from "../layouts/Layout.astro";
import { Icon } from "astro-icon/components";
// import { Camera, Heart, Sun } from "@lucide/astro";
const title = "Home";
---

<Layout title={title}>
  <main class="relative h-screen bg-[#070510] text-white flex flex-col p-6 overflow-hidden">
    <!-- Efek Glow Pojok Kiri Atas (Radial Aura) -->
    <div class="absolute top-0 left-0 -translate-x-1/3 -translate-y-1/3 w-[150vw] h-[1510vw] bg-gradient-to-tr from-[#1793d1]/30 via-[#1793d1]/10 to-transparent rounded-full blur-[100px] pointer-events-none"></div>
    <!-- <div class="absolute bottom-1/3 right-1/3 w-[400px] h-[400px] bg-purple-900/10 rounded-full blur-[120px] pointer-events-none"></div> -->
    <div class="hidden lg:block w-full border-b-1 border-blue-700 h-1"></div>
     

    <section class="h-screen grid grid-cols-1 lg:grid-cols-2">
      <!-- left -->
      <div class="flex flex-col lg:justify-between items-start gap-6 lg:max-w-1/3 mx-0 p-2 lg:p-10">
        <div class="flex items-end w-full justify-end lg:justify-start">
          <Icon name="lucide:sun" class="h-8 w-8 text-amber-50" />
</div>
        <header class="space-y-4">
          <h1 class="text-6xl font-extrabold tracking-tight text-transparent bg-clip-text bg-gradient-to-r from-[#00d8ff] via-[#17d1c5] to-green-500">
            Yuzikakal
          </h1>
          <p class="text-gray-400 text-sm md:text-base max-w-xl mx-auto leading-relaxed">
            Full-stack development, modern interfaces, and creative solution.
            Powered by Linux, Astro, and React.
          </p>
          
        </header>
</div>

      <nav class="flex flex-col gap-4 font-bold font-sekuya text-4xl md:text-9xl tracking-wide w-full justify-around items-end">
        <a href="/about" class="nav-glow-item">About</a>
<a href="/projects" class="nav-glow-item">Projects</a>
<a href="/artwork" class="nav-glow-item">Artwork</a>
        <a href="/contact" class="nav-glow-item">CONTACT</a>
</nav>
    </section>




