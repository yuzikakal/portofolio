---
import Layout from "../layouts/Layout.astro";
const title = "About";
---

<Layout title={title}>
    <section>
    <h1 class="nav-glow-item" transition:name="about" transition:animate="initial">About Me</h1>
    <p class="text-gray-300">
        I'm a passionate full-stack developer with a love for creating beautiful and functional web applications. With a background in both design and development, I bring a unique perspective to every project I work on.
    </p>
    <a href="/" class="text-blue-500 hover:underline mt-4 inline-block">Back to Home</a>
</section>
</Layout>