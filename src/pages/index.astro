---
import Layout from "../layouts/Layout.astro";
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import judul from "../assets/yuzika.png";
import ThemeToggle from "../components/ThemeToggle.astro";

const title = "Home";
const description =
  "Yuzikakal — full-stack developer crafting fast, precise interfaces with Astro, React, and Linux. Explore projects, artwork, and get in touch.";
const page = "~";

const navLinks = [
  { href: "/about", label: "About" },
  { href: "/projects", label: "Projects" },
  { href: "/artwork", label: "Artwork" },
  { href: "/contact", label: "Contact" },
];

const color = {
  dark: {
    textPrimary: "#ffffff",
    textSecondary: "#94a3b8",
    accentFrom: "#1793d1",
    accentTo: "#00d8ff",
    border: "#1a2540",
  },
  light: {
    textPrimary: "#0b1a2b",
    textSecondary: "#3b5266",
    accentFrom: "#0f6fa8",
    accentTo: "#1793d1",
    border: "#88b8d9",
  },
};
---

<Layout title={title} description={description}>
  <main class="relative min-h-screen flex flex-col p-6 lg:p-12 overflow-hidden">
  <!-- Ambient Blue Glow -->
  <div
    class={`absolute top-0 left-0 -translate-x-1/2 -translate-y-1/2 w-[300px] h-[300px] bg-[${color.light.accentFrom}]/20 dark:bg-[${color.dark.accentFrom}]/25 rounded-full blur-[140px] pointer-events-none`}
    aria-hidden="true"
  ></div>
  <div
    class={`absolute bottom-0 right-0 translate-x-1/3 translate-y-1/3 w-[300px] h-[300px] bg-[${color.light.accentTo}]/15 dark:bg-[${color.dark.accentTo}]/10 rounded-full blur-[120px] pointer-events-none`}
    aria-hidden="true"
  ></div>

  <!-- Header Navigation Bar -->
  <div class="relative z-10 flex justify-between items-center w-full max-w-7xl mx-auto">
    <p class="hidden lg:block font-mono text-xs tracking-wider">
      <span class={`text-[${color.light.accentFrom}] dark:text-[${color.dark.accentTo}] font-semibold`}>portfolio/</span>
      <span class={`text-[${color.light.textSecondary}] dark:text-[${color.dark.textSecondary}]`}>{page}</span>
    </p>

    <button
      aria-label="Toggle theme"
      class={`text-[${color.light.textSecondary}] dark:text-[${color.dark.textSecondary}] hover:text-[${color.light.accentFrom}] dark:hover:text-[${color.dark.accentTo}] transition-colors rounded-lg hover:bg-black/5 dark:hover:bg-white/5 p-1`}
    >
      <ThemeToggle />
    </button>
  </div>

  <!-- Hero Content -->
  <section class="relative z-10 max-w-7xl h-full mx-auto my-0 w-full grid grid-cols-1 lg:grid-cols-12 gap-12 flex-1 items-end pb-12">
    <!-- Left Column: Branding -->
    <div class="lg:col-span-7 flex flex-col justify-between items-start space-y-6 lg:space-y-4">
      <Image src={judul} alt="Yuzikakal — full-stack developer logo" class="w-48 lg:w-72" />
      <h1 class="sr-only">Yuzikakal — Full-Stack Developer Portfolio</h1>
      <h1 class="text-xl font-bold">Junior Frontend Developer & Tech Enthusiast</h1>
      <p class={`text-[${color.light.textSecondary}] dark:text-[${color.dark.textSecondary}] text-base sm:text-lg max-w-xl leading-relaxed`}>
        Software engineer student with a passion for crafting fast, precise interfaces and creative solutions. 
        Explore my projects, artwork, and get in touch to collaborate on exciting ventures.
      </p>

      <div class={`flex items-center gap-4 pt-2 font-mono text-xs text-[${color.light.textSecondary}] dark:text-[${color.dark.textSecondary}]`}>
        <a
          href="https://github.com/yuzikakal"
          target="_blank"
          rel="noopener noreferrer"
          class={`flex items-center gap-1.5 hover:text-[${color.light.accentFrom}] dark:hover:text-[${color.dark.accentTo}] transition-colors`}
        >
          <Icon name="lucide:github" class="w-4 h-4" />
          <span>GitHub</span>
        </a>
        <span class={`text-[${color.light.border}] dark:text-[${color.dark.border}]`} aria-hidden="true">•</span>
        <a
          href="mailto:contact@yuzikakal.dev"
          class={`flex items-center gap-1.5 hover:text-[${color.light.accentFrom}] dark:hover:text-[${color.dark.accentTo}] transition-colors`}
        >
          <Icon name="lucide:mail" class="w-4 h-4" />
          <span>Contact</span>
        </a>
      </div>
    </div>

    <!-- Right Column: Navigation -->
    <nav aria-label="Primary" class="lg:col-span-5 flex flex-col gap-3 font-chakra font-bold text-6xl lg:text-8xl 2xl:text-9xl tracking-tighter lg:items-end">
      {navLinks.map((link) => (
        <a 
          href={link.href} 
          class="nav-glow-item hover:tracking-widest transition-all duration-300" 
          transition:name={link.label}
        >
          {link.label}
        </a>
      ))}
    </nav>
  </section>
</main>
</Layout>