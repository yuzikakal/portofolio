---
import Layout from "../layouts/Layout.astro";
import { Icon } from "astro-icon/components";
import { Image } from 'astro:assets';
import judul from '../assets/yuzika.png';

const title = "Home";
---

<Layout title={title}>
  <main class="relative min-h-screen bg-[#070510] text-white flex flex-col p-6 lg:p-12 overflow-hidden justify-between">
    <!-- Ambient Background Glow (Dibuat Pas, Tidak Berat di GPU) -->
    <div class="absolute top-0 left-0 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-[#1793d1]/20 rounded-full blur-[140px] pointer-events-none"></div>
    <div class="absolute bottom-0 right-0 translate-x-1/3 translate-y-1/3 w-[500px] h-[500px] bg-[#00d8ff]/10 rounded-full blur-[120px] pointer-events-none"></div>

    <div class="relative z-10 flex justify-between items-center w-full max-w-7xl mx-auto border-b border-blue-700 pb-4">

      <button aria-label="Toggle Theme" class="p-2 text-gray-400 hover:text-[#00d8ff] transition-colors rounded-lg hover:bg-white/5">
        <Icon name="lucide:sun" class="h-5 w-5" />
      </button>
    </div>

    <!-- Hero Content Grid -->
    <section class="relative z-10 max-w-7xl mx-auto w-full grid grid-cols-1 lg:grid-cols-12 gap-12 items-center my-auto py-12">
      
      <!-- Left Column: Branding & Terminal Info (7 Columns) -->
      <div class="lg:col-span-7 flex flex-col justify-center items-start space-y-6">
        <Image src={judul} alt="Yuzikakal" class="w-48 lg:w-72" />
        <!-- <h1 class="text-5xl sm:text-7xl font-bold font-sekuya tracking-tight text-transparent bg-clip-text bg-gradient-to-r from-[#00d8ff] via-[#17d1c5] to-emerald-400">
          Yuzikakal
        </h1> -->
        
        <p class="text-gray-400 text-base sm:text-lg max-w-xl leading-relaxed">
          Full-stack development, modern interfaces, and creative solutions. 
          Crafting web experiences with precision, powered by Linux, Astro, and React.
        </p>

        <!-- Social / Micro-Links untuk Mengisi Ruang Kiri Bawah -->
        <div class="flex items-center gap-4 pt-2 font-mono text-xs text-gray-400">
          <a href="https://github.com" target="_blank" class="flex items-center gap-1.5 hover:text-[#00d8ff] transition-colors">
            <Icon name="lucide:github" class="w-4 h-4" />
            <span>GitHub</span>
          </a>
          <span class="text-gray-700">•</span>
          <a href="mailto:contact@yuzikakal.dev" class="flex items-center gap-1.5 hover:text-[#00d8ff] transition-colors">
            <Icon name="lucide:mail" class="w-4 h-4" />
            <span>Contact</span>
          </a>
        </div>
      </div>

      <!-- Right Column: Navigation -->
      <nav class="lg:col-span-5 flex flex-col gap-4 font-bold font-sekuya text-4xl sm:text-6xl lg:text-7xl tracking-wide lg:items-end">
        <a href="/about" class="nav-glow-item" transition:name="about" transition:animate="initial">About</a>
        <a href="/projects" class="nav-glow-item">Projects</a>
        <a href="/artwork" class="nav-glow-item">Artwork</a>
      </nav>

    </section>

    <!-- Bottom Footer -->
    <div class="relative z-10 max-w-7xl mx-auto w-full flex justify-between items-center text-xs font-mono text-gray-600 border-t border-white/5 pt-4">
      <span>© {new Date().getFullYear()} Yuzikakal</span>
      <span>Built with Astro</span>
    </div>
  </main>
</Layout>