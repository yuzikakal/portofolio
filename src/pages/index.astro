---
import Layout from '../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';
---

<Layout>
  <!-- Background Container: Deep Dark Violet/Obsidian -->
  <main class="relative min-h-screen bg-[#070510] text-white flex flex-col items-center justify-center p-6 overflow-hidden">
    
    <!-- Background Glow Effect (Arch Blue & Purple Ambient) -->
    <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] bg-[#1793d1]/15 rounded-full blur-[120px] pointer-events-none"></div>
    <div class="absolute bottom-1/3 left-1/3 w-[350px] h-[350px] bg-purple-900/10 rounded-full blur-[100px] pointer-events-none"></div>

    <!-- Hero Section Content -->
    <section class="relative z-10 max-w-3xl text-center space-y-6">
      
      <!-- Status Badge -->
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-[#1793d1]/10 border border-[#1793d1]/30 text-[#00d8ff] text-xs font-mono">
        <span class="w-2 h-2 rounded-full bg-[#00d8ff] animate-ping"></span>
        <span>Portfolio testing</span>
      </div>

      <!-- Main Headline -->
      <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight">
        Building Web Experience with <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#00d8ff] via-[#1793d1] to-purple-400">Precision & Art</span>
      </h1>

      <!-- Subtitle -->
      <p class="text-gray-400 text-sm md:text-base max-w-xl mx-auto leading-relaxed">
        Full-stack development, modern interfaces, and creative solution. Powered by Linux, Astro, and React.
      </p>

      <!-- Action Buttons -->
      <div class="flex items-center justify-center gap-4 pt-4">
        <a 
          href="#projects" 
          class="px-6 py-3 rounded-lg bg-[#1793d1] text-white font-medium text-sm hover:bg-[#00d8ff] hover:text-black transition-all duration-200 shadow-[0_0_20px_rgba(23,147,209,0.4)]"
        >
          See Projects
        </a>
        <a 
          href="#contact" 
          class="px-6 py-3 rounded-lg bg-white/5 border border-white/10 text-gray-300 font-medium text-sm hover:bg-white/10 hover:text-white transition-all duration-200 backdrop-blur-sm"
        >
          Contact Me
        </a>
      </div>

    </section>

  </main>
</Layout>