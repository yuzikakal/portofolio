---
import ThemeToggle from "./ThemeToggle.astro";
import { Icon } from "astro-icon/components";
import avatarImg from "../assets/yuzika.png";
---

<header class="fixed top-0 z-50">
  <!-- Top Navigation -->
  <div
    class="flex flex-row lg:flex-col lg:h-screen w-screen lg:w-16 justify-between items-center p-2"
  >
    <!-- Logo -->
    <a
      href="/"
      class="flex lg:hidden items-center gap-3 font-mono text-sm font-semibold text-white group min-h-fit "
    >
      <img
        src={avatarImg.src}
        alt="Logo"
        width={50}
        height={30}
        class="lg:w-25 object-contain grayscale brightness-0"
      />
    </a>
    <div class="flex flex-row">
      <!-- Mobile Menu Trigger Button -->
      <button
        id="menu-toggle-btn"
        aria-label="Toggle Navigation"
        class="flex text-blue-900 rounded-md transition-colors focus:outline-none p-1"
      >
        <Icon name="lucide:text-align-justify" class="w-6 h-6" />
      </button>
    </div>
  </div>
</header>
